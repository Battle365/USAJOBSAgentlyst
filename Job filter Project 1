@dataclass(frozen=True)
class Preferences:
    minimum_grade: int
    locations: list[str]
    remote_only: bool
    keywords: list[str]
    profile: dict[str, list[str]] = field(default_factory=dict)


def _first(items: Any, key: str, default: str = "") -> str:
    if isinstance(items, list) and items and isinstance(items[0], dict):
        return str(items[0].get(key, default))
    return default


def parse_profile_entries(value: str) -> list[str]:
    return [entry.strip() for entry in re.split(r"[,\n]", value) if entry.strip()]


def configured_secret(name: str) -> str:
    try:
        secret_value = st.secrets.get(name, "")
    except Exception:
        secret_value = ""
    return str(secret_value or os.getenv(name, ""))


def _field_text(container: dict[str, Any], keys: list[str]) -> str:
    values = []
    for key in keys:
        value = container.get(key, "")
        if isinstance(value, list):
            values.extend(str(item.get("Value", item)) if isinstance(item, dict) else str(item) for item in value)
        elif value:
            values.append(str(value))
    return " ".join(value for value in values if value)


def announcement_url(descriptor: dict[str, Any]) -> str:
    position_uri = str(descriptor.get("PositionURI", "")).strip()
    parsed_uri = urlparse(position_uri)
    if parsed_uri.scheme == "https" and parsed_uri.hostname == "www.usajobs.gov" and parsed_uri.path:
        return position_uri
    position_id = str(descriptor.get("PositionID", "")).strip()
    if position_id.isdigit() and int(position_id) > 0:
        return f"https://www.usajobs.gov/job/{position_id}"
    return ""


def application_url(job: dict[str, Any]) -> str:
    url = str(job.get("url", "")).strip()
    parsed_url = urlparse(url)
    if parsed_url.path.startswith("/job/"):
        return parsed_url._replace(fragment="apply").geturl()
    return url


def normalize_job(item: dict[str, Any]) -> dict[str, Any]:
    descriptor = item.get("MatchedObjectDescriptor", item)
    details = descriptor.get("UserArea", {}).get("Details", {})
    grade_text = _first(descriptor.get("JobGrade"), "Code")
    grade_number = int(grade_text.replace("GS-", "").split("/")[0]) if grade_text.startswith("GS-") else 0
    close_date = descriptor.get("ApplicationCloseDate", "")[:10]

    remuneration = descriptor.get("PositionRemuneration", [])
    salary = "Not listed"
    if remuneration and isinstance(remuneration[0], dict):
        minimum = remuneration[0].get("MinimumRange", "")
        maximum = remuneration[0].get("MaximumRange", "")
        interval = remuneration[0].get("RateIntervalCode", "PA")
        if minimum and maximum:
            minimum_text = str(minimum).replace("$", "")
            maximum_text = str(maximum).replace("$", "")
            salary = f"USD {minimum_text} - {maximum_text} / {interval}"

    duties = _field_text(details, ["MajorDuties", "Duties", "Responsibilities"])
    qualifications = _field_text(descriptor, ["QualificationSummary", "Requirements", "SpecializedExperience"])
    education_requirements = _field_text(details, ["Education", "EducationRequirements"])
    certification_requirements = _field_text(details, ["Certifications", "CertificationRequirements"])
    required_documents = _field_text(details, ["RequiredDocuments", "RequiredDocument"])

    return {
        "id": descriptor.get("PositionURI", descriptor.get("PositionID", "")),
        "title": descriptor.get("PositionTitle", "Untitled position"),
        "agency": descriptor.get("OrganizationName", descriptor.get("DepartmentName", "Federal agency")),
        "location": descriptor.get("PositionLocationDisplay", "Location not listed"),
        "grade": grade_text or "Grade not listed",
        "grade_number": grade_number,
        "schedule": _first(descriptor.get("PositionSchedule"), "Name", "Schedule not listed"),
        "salary": salary,
        "summary": details.get("JobSummary", descriptor.get("QualificationSummary", "No summary provided.")),
        "duties": duties,
        "qualifications": qualifications,
        "specialized_experience": _field_text(descriptor, ["SpecializedExperience"]),
        "education_requirements": education_requirements,
        "certification_requirements": certification_requirements,
        "required_documents": [required_documents] if required_documents else [],
        "close_date": close_date,
        "url": announcement_url(descriptor),
    }


def _normalized_text(value: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9]+", " ", value.lower())).strip()


def _contains_term(text: str, term: str) -> bool:
    return re.search(rf"\b{re.escape(term)}\b", text) is not None


def location_tier(location: str) -> tuple[int, str]:
    normalized_location = _normalized_text(location)
    for target, label in LOCAL_TARGETS.items():
        if _contains_term(normalized_location, target):
            return 2, f"local target: {label}"
    if "remote" in normalized_location:
        return 1, "remote-compatible location"
    return 0, f"distant location: {location or 'not listed'}"


def prepare_application(
    job: dict[str, Any],
    profile_keywords: list[str] | None = None,
    profile: dict[str, list[str]] | None = None,
) -> dict[str, Any]:
    profile_keywords = [str(keyword).strip() for keyword in (profile_keywords or []) if str(keyword).strip()]
    searchable = _normalized_text(" ".join(str(job.get(field, "")) for field in (
        "title",
        "summary",
        "duties",
        "qualifications",
        "specialized_experience",
        "education_requirements",
        "certification_requirements",
    )))
    matched_profile = [keyword for keyword in profile_keywords if _contains_term(searchable, _normalized_text(keyword))]
    unmatched_profile = [keyword for keyword in profile_keywords if keyword not in matched_profile]
    evidence = profile_evidence(job, profile or {})

    return {
        "job_id": job["id"],
        "title": job["title"],
        "announcement_url": job["url"],
        "status": "prepared for review",
        "application_information": {
            "agency": job["agency"],
            "grade": job["grade"],
            "location": job["location"],
            "salary": job["salary"],
            "closing_date": job["close_date"] or "Not listed",
        },
        "profile_comparison": {
            "matched_skills_or_experience": matched_profile,
            "not_found_in_announcement": unmatched_profile,
        },
        "profile_by_category": profile or {},
        "match_analysis": evidence,
        "draft_responses": [
            {
                "prompt": "Why are you interested in this position?",
                "draft": "Draft prompt only. Add your own truthful experience and motivation before approval.",
            },
            {
                "prompt": "How does your experience meet the requirements?",
                "draft": "Draft prompt only. Verify every statement against your background before approval.",
            },
        ],
        "required_documents": job.get("required_documents") or [
            "Resume or federal resume, as required by the announcement",
            "Supporting documents listed in the official announcement",
        ],
        "steps": [
            "Review the official announcement and eligibility requirements",
            "Confirm resume and supporting documents for this announcement",
            "Review application responses before requesting approval",
            "Request approval before any submission action",
        ],
        "actions_not_performed": [
            "No application submitted",
            "No documents uploaded, altered, or modified",
            "No USAJOBS account login or account changes",
            "No certification, attestation, or final application decision",
        ],
    }


def submit_application(job: dict[str, Any], packet: dict[str, Any] | None = None) -> dict[str, Any]:
    prepared_packet = packet or prepare_application(job)
    submission = dict(prepared_packet)
    submission["status"] = "submitted for final review"
    submission["submission_status"] = {
        "manual_approval_required": True,
        "submitted_to_usajobs": False,
        "notes": [
            "No external application request was sent",
            "This action only marks the job for final review and approval.",
        ],
    }
    return submission


def family_relevance(job: dict[str, Any]) -> tuple[int, str]:
    title = _normalized_text(job["title"])
    summary = _normalized_text(job["summary"])
    if title in TITLE_TARGETS:
        return 40, "exact title match"
    if any(_contains_term(title, target) for target in TITLE_TARGETS):
        return 30, "close title or occupation match"
    if any(_contains_term(summary, term) for term in RELATED_DESCRIPTION_TERMS):
        return 18, "strong description keyword match"
    return 8, "weak target-family keyword match"


def profile_field_matches(job: dict[str, Any], profile: dict[str, list[str]]) -> dict[str, list[str]]:
    category_fields = {
        "education": ["education_requirements"],
        "certifications": ["certification_requirements"],
        "federal_program_analysis": ["specialized_experience", "qualifications", "duties"],
        "relevant_work_experience": ["specialized_experience", "qualifications", "duties"],
    }
    general_fields = [
        "title",
        "summary",
        "duties",
        "qualifications",
        "specialized_experience",
        "education_requirements",
        "certification_requirements",
    ]
    matches = {}
    for category, entries in profile.items():
        fields = category_fields.get(category, general_fields)
        searchable = _normalized_text(" ".join(str(job.get(field, "")) for field in fields))
        matches[category] = [entry for entry in entries if _contains_term(searchable, _normalized_text(entry))]
    return matches


def profile_evidence(job: dict[str, Any], profile: dict[str, list[str]]) -> dict[str, Any]:
    announcement_text = _normalized_text(" ".join(str(job.get(field, "")) for field in (
        "title", "summary", "duties", "qualifications", "specialized_experience",
        "education_requirements", "certification_requirements",
    )))
    specialized_text = _normalized_text(" ".join(str(job.get(field, "")) for field in (
        "duties", "specialized_experience", "qualifications",
    )))
    qualification_text = _normalized_text(str(job.get("qualifications", "")))
    required_signal = any(term in qualification_text for term in ("required", "must", "minimum", "specialized experience"))
    preferred_signal = any(term in qualification_text for term in ("preferred", "desired", "may be substituted"))

    direct = []
    transferable = []
    gaps = []
    for category, entries in profile.items():
        for entry in entries:
            normalized_entry = _normalized_text(entry)
            if not normalized_entry:
                continue
            if _contains_term(specialized_text, normalized_entry):
                direct.append(f"{entry} ({category})")
            elif _contains_term(announcement_text, normalized_entry):
                transferable.append(f"{entry} ({category})")
            else:
                aliases = TRANSFERABLE_TERMS.get(normalized_entry, [])
                if any(_contains_term(announcement_text, _normalized_text(alias)) for alias in aliases):
                    transferable.append(f"{entry} ({category})")
                else:
                    gaps.append(f"{entry} ({category})")

    return {
        "direct_specialized_matches": direct,
        "transferable_matches": transferable,
        "profile_gaps": gaps,
        "matched_required": direct + transferable if required_signal else [],
        "matched_preferred": direct + transferable if preferred_signal else [],
        "qualification_status": "qualified evidence found" if direct or transferable else "insufficient evidence found",
    }


def _raise_for_response(response: Any) -> None:
    try:
        response.raise_for_status()
    except Exception as exc:  # pragma: no cover - dispatched by requests HTTPError
        status_code = getattr(response, "status_code", None)
        if status_code == 401:
            raise ValueError(
                "USAJOBS rejected the API key or email. Verify the USAJOBS API key and the registered email address."
            ) from exc
        raise


@st.cache_data(ttl=300, show_spinner=False)
def fetch_search_term(term: str, api_key: str, email: str) -> list[dict[str, Any]]:
    response = requests.get(
        API_URL,
        headers={"Host": "data.usajobs.gov", "User-Agent": email, "Authorization-Key": api_key},
        params={"Keyword": term, "ResultsPerPage": 25, "Fields": "Full"},
        timeout=20,
    )
    _raise_for_response(response)
    return response.json().get("SearchResult", {}).get("SearchResultItems", [])


def search_jobs(preferences: Preferences, api_key: str = "", email: str = "", request_get: Any = requests.get) -> tuple[list[dict[str, Any]], bool]:
    headers = {"Host": "data.usajobs.gov", "User-Agent": email, "Authorization-Key": api_key}
    params = {"ResultsPerPage": 25, "Fields": "Full"}

    if not api_key or not email:
        jobs = DEMO_JOBS
        return review_jobs([normalize_job(job) for job in jobs], preferences), True

    items_by_id = {}
    for term in SEARCH_TERMS:
        if request_get is requests.get:
            items = fetch_search_term(term, api_key, email)
        else:
            response = request_get(API_URL, headers=headers, params={**params, "Keyword": term}, timeout=20)
            _raise_for_response(response)
            items = response.json().get("SearchResult", {}).get("SearchResultItems", [])
        for item in items:
            normalized = normalize_job(item)
            items_by_id[normalized["id"]] = normalized

    jobs = list(items_by_id.values())
    return review_jobs(jobs, preferences), False


def review_jobs(jobs: list[dict[str, Any]], preferences: Preferences) -> list[dict[str, Any]]:
    reviewed = []
    for job in jobs:
        searchable = _normalized_text(" ".join(str(job.get(field, "")) for field in (
            "title",
            "summary",
            "location",
            "duties",
            "qualifications",
            "specialized_experience",
            "education_requirements",
            "certification_requirements",
        )))

        location_rank, location_reason = location_tier(job["location"])
        job["location_rank"] = location_rank

        family_points, family_reason = family_relevance(job)
        score = family_points
        reasons = [location_reason, family_reason]

        if job["grade_number"] >= preferences.minimum_grade:
            score += 25
            reasons.append(f"meets GS-{preferences.minimum_grade}+ target")
        else:
            reasons.append("below preferred grade")

        if preferences.remote_only and "remote" not in job["location"].lower():
            score -= 25
            reasons.append("not listed as remote")
        elif "remote" in job["location"].lower():
            score += 15
            reasons.append("remote location")

        if preferences.locations and any(location.lower() in job["location"].lower() for location in preferences.locations):
            score += 15
            reasons.append("location preference match")

        keyword_hits = [keyword for keyword in preferences.keywords if keyword and _contains_term(searchable, _normalized_text(keyword))]
        if keyword_hits:
            score += min(25, len(keyword_hits) * 5)
            reasons.append(f"keyword match: {', '.join(keyword_hits)}")

        category_matches = profile_field_matches(job, preferences.profile)
        matched_categories = [
            f"{category}: {', '.join(matches)}"
            for category, matches in category_matches.items()
            if matches
        ]
        if matched_categories:
            job["profile_matches"] = category_matches
            reasons.append("profile evidence: " + "; ".join(matched_categories))

        evidence = profile_evidence(job, preferences.profile)
        if evidence["direct_specialized_matches"]:
            score += min(20, len(evidence["direct_specialized_matches"]) * 4)
            reasons.append(f"specialized experience evidence: {len(evidence['direct_specialized_matches'])} matches")
        if evidence["transferable_matches"]:
            score += min(10, len(evidence["transferable_matches"]) * 2)
            reasons.append(f"transferable experience evidence: {len(evidence['transferable_matches'])} matches")
        job["match_analysis"] = evidence

        job["score"] = max(0, min(score, 100))
        job["reasons"] = reasons
        reviewed.append(job)

    return sorted(reviewed, key=lambda job: (job["location_rank"], job["score"], job["close_date"]), reverse=True)


def format_close_date(value: str) -> str:
    try:
        return datetime.strptime(value, "%Y-%m-%d").strftime("%b %-d, %Y")
    except ValueError:
        return value or "Not listed"


def render_job(job: dict[str, Any], index: str, preferences: Preferences | None = None) -> None:
    close_date = format_close_date(job["close_date"])
    with st.container(border=True):
        left, right = st.columns([4, 1])
        with left:
            selected = st.checkbox("Select for application preparation", key=f"select-{index}-{job['id']}")
            if selected:
                st.session_state.selected_jobs.add(job["id"])
            else:
                st.session_state.selected_jobs.discard(job["id"])

            st.subheader(job["title"])
            st.caption(f"{job['agency']} | {job['location']}")
            st.write(job["summary"])
            st.markdown(f"**{job['grade']}** · {job['schedule']} · **{job['salary']}** · Closes **{close_date}**")
            st.caption("Review signals: " + " · ".join(job["reasons"]))

            analysis = job.get("match_analysis", {})
            if analysis:
                st.caption(f"Qualification assessment: {analysis['qualification_status']}. This is evidence screening, not an eligibility determination.")
                if analysis["direct_specialized_matches"]:
                    st.write("**Direct specialized evidence:** " + ", ".join(analysis["direct_specialized_matches"][:6]))
                if analysis["transferable_matches"]:
                    st.write("**Transferable evidence:** " + ", ".join(analysis["transferable_matches"][:6]))
                if analysis["profile_gaps"]:
                    st.write("**Missing or uncertain:** " + ", ".join(analysis["profile_gaps"][:6]))

        with right:
            st.metric("Fit", f"{job['score']}%")
            if job["url"]:
                st.link_button("Review Announcement", job["url"], use_container_width=True)

                if st.button("Prepare & Review", key=f"prepare-{index}", use_container_width=True):
                    st.session_state.ready_jobs.add(job["id"])
                    st.session_state.prepared_jobs[job["id"]] = prepare_application(
                        job,
                        (preferences.keywords if preferences else []),
                        (preferences.profile if preferences else {}),
                    )
                    st.toast("Announcement reviewed and application materials prepared.")

                if job["id"] in st.session_state.prepared_jobs:
                    st.link_button("Open announcement", job["url"], type="primary", use_container_width=True)
            else:
                st.button(
                    "Review Announcement",
                    key=f"announcement-unavailable-{index}",
                    use_container_width=True,
                    disabled=True,
                    help="Available when live USAJOBS announcement data is loaded.",
                )

            if st.button("Add to checklist", key=f"ready-{index}", use_container_width=True):
                st.session_state.ready_jobs.add(job["id"])
                st.toast("Added for your review. Nothing was submitted.")



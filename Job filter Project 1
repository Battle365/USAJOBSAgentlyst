    with st.sidebar:
        st.header("Review preferences")
        minimum_grade = st.slider("Minimum GS grade", 5, 15, 11)
        locations = st.text_input("Preferred locations", placeholder="DC, remote, Denver")
        remote_only = st.checkbox("Remote only")

        st.subheader("User skills profile")
        st.caption("Session-only profile. Entries are used for matching and preparation review; nothing is saved externally.")
        profile = {}
        for key, label, placeholder in PROFILE_SECTIONS:
            default_value = ", ".join(RESUME_PROFILE.get(key, []))
            profile[key] = parse_profile_entries(st.text_area(label, value=default_value, placeholder=placeholder, key=f"profile-{key}"))

        st.divider()
        api_key = configured_secret("USAJOBS_API_KEY")
        email = configured_secret("USAJOBS_EMAIL")
        if not api_key or len(api_key) > 100:
            api_key = st.text_input(
                "USAJOBS API key for this session",
                type="password",
                help="Used only for this Streamlit session. It is not saved or displayed.",
            )
        st.caption("The API key is masked and used only for this session. If no valid credentials are supplied, the app stays in demo mode.")

        run_search = st.button("Refresh job matches", type="primary", use_container_width=True)

    preferences = Preferences(
        minimum_grade=minimum_grade,
        locations=[value.strip() for value in locations.split(",") if value.strip()],
        remote_only=remote_only,
        keywords=[entry for entries in profile.values() for entry in entries],
        profile=profile,
    )

    if run_search or "jobs" not in st.session_state:
        try:
            with st.spinner("Reviewing current federal announcements..."):
                st.session_state.jobs, st.session_state.demo_mode = search_jobs(preferences, api_key, email)
        except ValueError as error:
            st.error(str(error))
            return
        except requests.RequestException as error:
            st.error(f"USAJOBS could not be reached: {error}")
            return
        except (KeyError, TypeError) as error:
            st.error(f"USAJOBS returned an unexpected response: {error}")
            return
    elif st.session_state.get("jobs"):
        st.session_state.jobs = review_jobs(st.session_state.jobs, preferences)

    jobs = st.session_state.get("jobs", [])

    if st.session_state.get("demo_mode"):
        st.info("Demo mode is active. Add a USAJOBS API key and email in the sidebar to review live announcements.")

    ready_jobs = [job for job in jobs if job["id"] in st.session_state.ready_jobs]

    metrics = st.columns(3)
    metrics[0].metric("Jobs reviewed", len(jobs))
    metrics[1].metric("Strong matches", sum(job["score"] >= 70 for job in jobs))
    metrics[2].metric("Ready for your review", len(ready_jobs))

    selected_jobs = [job for job in jobs if job["id"] in st.session_state.selected_jobs]
    if selected_jobs:
        st.subheader("Application preparation")
        st.write("Preparation gathers the announcement and review checklist only. It does not apply or submit anything.")
        if st.button("Prepare selected applications", type="secondary"):
            for job in selected_jobs:
                st.session_state.prepared_jobs[job["id"]] = prepare_application(
                    job,
                    preferences.keywords,
                    preferences.profile,
                )
            st.toast("Application materials are ready for your review")

    prepared_jobs = [job for job in jobs if job["id"] in st.session_state.prepared_jobs]
    if prepared_jobs:
        st.subheader("Prepared applications")
        if st.button("← Go back to review queue", key="back-to-review"):
            st.session_state.prepared_jobs = {}
            st.toast("Returned to the review queue.")

        for job in prepared_jobs:
            packet = st.session_state.prepared_jobs[job["id"]]
            st.markdown(f"**{packet['title']}** · {packet['status']}")
            st.write("**Application information**", packet["application_information"])

            comparison = packet["profile_comparison"]
            st.write("**Profile comparison**")
            st.write("Matched: " + (", ".join(comparison["matched_skills_or_experience"]) or "No direct matches found"))
            st.write("Not found in announcement: " + (", ".join(comparison["not_found_in_announcement"]) or "None"))

            analysis = packet["match_analysis"]
            st.write("**Qualification evidence**")
            st.write("Direct specialized: " + (", ".join(analysis["direct_specialized_matches"]) or "None found"))
            st.write("Transferable: " + (", ".join(analysis["transferable_matches"]) or "None found"))
            st.write("Required evidence: " + (", ".join(analysis["matched_required"]) or "Not established"))
            st.write("Preferred evidence: " + (", ".join(analysis["matched_preferred"]) or "Not established"))
            st.write("Missing or uncertain: " + (", ".join(analysis["profile_gaps"]) or "None identified"))

            st.write("**Draft responses**")
            for response in packet["draft_responses"]:
                st.caption(response["prompt"])
                st.text(response["draft"])

            st.write("**Documents to review**")
            for document in packet["required_documents"]:
                st.checkbox(document, key=f"document-{job['id']}-{document}")

            for step in packet["steps"]:
                st.checkbox(step, key=f"prep-{job['id']}-{step}")

            st.caption("Preparation is informational and read-only. Drafts are not submitted automatically.")

            if packet["announcement_url"]:
                st.link_button("Open announcement", packet["announcement_url"])

            if st.button("Submit for final review", key=f"submit-prepared-{job['id']}"):
                st.session_state.prepared_jobs[job["id"]] = submit_application(job, packet)
                st.session_state.submitted_jobs.add(job["id"])
                st.toast("Marked for final review. No external application request was sent.")

            if job["id"] in st.session_state.submitted_jobs and packet["announcement_url"]:
                st.link_button("Continue to application", application_url(job), type="primary", use_container_width=True)

        st.info("Preparation is complete when you are satisfied with the checklist. Use the Submit for final review button to mark the job as ready for human approval.")

    if ready_jobs:
        st.subheader("Your application checklist")
        st.write("The agent pauses here. Review eligibility, materials, and the announcement before submitting anything.")
        for job in ready_jobs:
            submitted = job["id"] in st.session_state.submitted_jobs
            st.checkbox(f"{job['title']} · {job['grade']} · closes {format_close_date(job['close_date'])}", key=f"check-{job['id']}", value=submitted)
            if job["url"]:
                st.link_button("Review announcement on USAJOBS", job["url"])
            if st.button("Submit", key=f"submit-ready-{job['id']}", type="primary"):
                st.session_state.submitted_jobs.add(job["id"])
                st.session_state.prepared_jobs[job["id"]] = submit_application(job, st.session_state.prepared_jobs.get(job["id"]))
                st.toast("Submitted for final review. No external application request was sent.")
            if submitted and job["url"]:
                st.link_button("Continue to application", application_url(job), type="primary")
            if submitted:
                st.success("Marked as submitted for final review.")
            else:
                st.warning("No application has been submitted. Submit only after your final review.")

    st.divider()
    st.subheader("Ranked review queue")

    if not jobs:
        st.warning("No matching announcements were found.")
    else:
        tier_labels = {
            2: "Local Gulf Coast targets",
            1: "Remote-compatible jobs",
            0: "Distant results",
        }
        for tier in (2, 1, 0):
            tier_jobs = [job for job in jobs if job["location_rank"] == tier]
            if tier_jobs:
                st.markdown(f"### {tier_labels[tier]}")
                for index, job in enumerate(tier_jobs):
                    render_job(job, f"{tier}-{index}", preferences)


if __name__ == "__main__":
    main()

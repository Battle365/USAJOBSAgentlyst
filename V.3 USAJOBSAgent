# ============================================================

# API FUNCTIONS

# ============================================================

def get_headers():

    return {

        "Host": "data.usajobs.gov",

        "User-Agent": API_EMAIL or "",

        "Authorization-Key": API_KEY or ""

    }

def search_jobs(job_type, location):

    if not API_KEY or not API_EMAIL:

        st.error(

            "USAJOBS API configuration is missing. "

            "Set USAJOBS_API_KEY and USAJOBS_API_EMAIL "

            "in your environment variables."

        )

        return []

    params = {

        "PositionTitle": job_type,

        "LocationName": location,

        "Fields": "Full",

        "ResultsPerPage": 50,

        "Page": 1,

        "SortField": "closingdate",

        "SortDirection": "Asc"

    }

    try:

        response = requests.get(

            API_URL,

            headers=get_headers(),

            params=params,

            timeout=30

        )

        response.raise_for_status()

        data = response.json()

        items = (

            data

            .get("SearchResult", {})

            .get("SearchResultItems", [])

        )

        return items

    except requests.exceptions.RequestException as error:

        st.error(

            f"USAJOBS connection error: {error}"

        )

        return []

    except ValueError:

        st.error(

            "USAJOBS returned an invalid response."

        )

        return []

# ============================================================

# HELPER FUNCTIONS

# ============================================================

def clean(value):

    if not value:

        return ""

    if isinstance(value, list):

        value = " ".join(

            str(x)

            for x in value

        )

    return re.sub(

        r"\s+",

        " ",

        str(value)

    ).strip()

def normalize(value):

    value = clean(value).lower()

    value = re.sub(

        r"[^a-z0-9\s]",

        " ",

        value

    )

    return re.sub(

        r"\s+",

        " ",

        value

    )

def format_date(value):

    if not value:

        return "Not provided"

    return str(value)[:10]

def is_va_job(job):

    agency = normalize(

        job.get("agency", "")

    )

    department = normalize(

        job.get("department", "")

    )

    combined = (

        agency

        + " "

        + department

    )

    return (

        "veterans affairs" in combined

        or "department of veterans affairs" in combined

    )

# ============================================================

# EXTRACT JOB

# ============================================================

def extract_job(item):

    descriptor = item.get(

        "MatchedObjectDescriptor",

        {}

    )

    locations_data = descriptor.get(

        "PositionLocation",

        []

    )

    location_names = []

    for location in locations_data:

        if isinstance(location, dict):

            name = clean(

                location.get(

                    "LocationName"

                )

            )

            if name:

                location_names.append(name)

    grades = descriptor.get(

        "JobGrade",

        []

    )

    grade_names = []

    for grade in grades:

        if isinstance(grade, dict):

            value = clean(

                grade.get("Code")

                or grade.get("Name")

            )

            if value:

                grade_names.append(value)

    salary = descriptor.get(

        "PositionRemuneration",

        []

    )

    salary_text = ""

    if salary:

        first_salary = salary[0]

        minimum = first_salary.get(

            "MinimumRange"

        )

        maximum = first_salary.get(

            "MaximumRange"

        )

        if minimum and maximum:

            salary_text = (

                f"${minimum} - ${maximum}"

            )

    details = (

        descriptor

        .get("UserArea", {})

        .get("Details", {})

    )

    # USAJOBS provides the date the opportunity

    # is open for applications.

    open_date = (

        descriptor.get("PositionStartDate")

        or descriptor.get("PublicationStartDate")

    )

    return {

        "title": clean(

            descriptor.get("PositionTitle")

        ),

        "agency": clean(

            descriptor.get("OrganizationName")

        ),

        "department": clean(

            descriptor.get("DepartmentName")

        ),

        "location": ", ".join(

            location_names

        ),

        "grade": ", ".join(

            grade_names

        ),

        "salary": salary_text,

        "announcement_number": clean(

            descriptor.get("PositionID")

        ),

        "announcement_url": descriptor.get(

            "PositionURI",

            ""

        ),

        "apply_url": descriptor.get(

            "ApplyURI",

            ""

        ),

        "open_date": open_date,

        "close_date": descriptor.get(

            "ApplicationCloseDate"

        ),

        "duties": clean(

            details.get("MajorDuties")

        ),

        "education": clean(

            details.get("Education")

        ),

        "requirements": clean(

            details.get("Requirements")

        ),

        "qualification": clean(

            descriptor.get(

                "QualificationSummary"

            )

        )

    }


    if not job_types:

        st.warning(

            "Select at least one job type."

        )

        st.stop()

    if not locations:

        st.warning(

            "Select at least one location."

        )

        st.stop()

    applicant_profile = " ".join([

        resume,

        skills,

        education

    ])

    jobs = []

    with st.spinner(

        "Searching current Department of Veterans Affairs positions..."

    ):

        for job_type in job_types:

            for location in locations:

                results = search_jobs(

                    job_type,

                    location

                )

                for result in results:

                    job = extract_job(

                        result

                    )

                    # Make sure the result is actually VA.

                    if is_va_job(job):

                        jobs.append(

                            job

                        )

    # --------------------------------------------------------

    # Remove duplicates

    # --------------------------------------------------------

    unique_jobs = {}

    for job in jobs:

        number = job[

            "announcement_number"

        ]

        if number:

            unique_jobs[number] = job

    jobs = list(

        unique_jobs.values()

    )

    # --------------------------------------------------------

    # Calculate matches

    # --------------------------------------------------------

    for job in jobs:

        score, matched = calculate_match(

            job,

            applicant_profile

        )

        job["score"] = score

        job["matched"] = matched

        job["status"] = (

            "MATCH"

            if score >= 40

            else "NOT A MATCH"

        )

    # --------------------------------------------------------

    # Sort

    # --------------------------------------------------------

    jobs.sort(

        key=lambda job: (

            job["status"] != "MATCH",

            -job["score"]

        )

    )

    st.session_state["jobs"] = jobs

    st.session_state[

        "applicant_profile"

    ] = applicant_profile


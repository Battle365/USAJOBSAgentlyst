# MATCHING ENGINE

# ============================================================

MATCH_TERMS = [

    "program analyst",

    "program analysis",

    "management analyst",

    "management analysis",

    "information technology",

    "it specialist",

    "information systems",

    "data analysis",

    "data management",

    "data analytics",

    "reporting",

    "reports",

    "excel",

    "power bi",

    "sql",

    "python",

    "database",

    "databases",

    "process improvement",

    "workflow",

    "workflows",

    "operations",

    "operational",

    "healthcare",

    "health care",

    "veterans",

    "veterans affairs",

    "federal",

    "documentation",

    "quality improvement",

    "project management",

    "program management",

    "performance",

    "metrics",

    "information systems",

    "systems analysis",

    "data quality",

    "data management"

]

def calculate_match(job, applicant):

    applicant_text = normalize(

        applicant

    )

    job_title = normalize(

        job["title"]

    )

    announcement_text = normalize(

        " ".join([

            job["title"],

            job["duties"],

            job["education"],

            job["requirements"],

            job["qualification"]

        ])

    )

    matched = []

    for term in MATCH_TERMS:

        applicant_has_term = (

            term in applicant_text

        )

        job_has_term = (

            term in announcement_text

        )

        if applicant_has_term and job_has_term:

            matched.append(term)

    # --------------------------------------------------------

    # Score

    # --------------------------------------------------------

    score = 0

    # Each shared skill/experience term contributes points.

    score += min(

        len(matched) * 7,

        70

    )

    # Job title relevance.

    title_matches = 0

    for term in [

        "program analyst",

        "management analyst",

        "information technology",

        "it specialist",

        "information systems"

    ]:

        if (

            term in applicant_text

            and term in job_title

        ):

            title_matches += 1

    score += min(

        title_matches * 15,

        20

    )

    # Experience depth.

    if len(matched) >= 8:

        score += 10

    elif len(matched) >= 5:

        score += 5

    score = min(

        score,

        100

    )

    return score, matched

# ============================================================

# APPLICATION PREPARATION

# ============================================================

def prepare_application(job, applicant):

    applicant_text = normalize(

        applicant

    )

    announcement_text = normalize(

        " ".join([

            job["title"],

            job["duties"],

            job["requirements"],

            job["qualification"]

        ])

    )

    relevant = []

    for term in MATCH_TERMS:

        if (

            term in applicant_text

            and term in announcement_text

        ):

            relevant.append(term)

    return relevant

